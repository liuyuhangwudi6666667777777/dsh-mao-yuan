{
  "name": "dsh-mao-yuan",
  "version": "0.4.0",
  "description": "毛选溯源参谋：以《毛泽东选集》方法论拆解问题，每个判断可回溯原文出处。关键词检索 + 强制引用 + 会话内持续生效。",
  "private": false,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "maoxuan",
    "mao",
    "rag",
    "retrieval",
    "methodology"
  ],
  "scripts": {
    "corpus": "node scripts/fetch-corpus.mjs",
    "test": "node --test \"test/*.test.js\"",
    "eval": "node scripts/eval.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc <2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc <2",
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
